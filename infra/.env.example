# rename to .env and fill in the values for docker compose

### Keycloak ###
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_POSTGRES_USER=
KEYCLOAK_POSTGRES_PASSWORD=

### Services & DB ###
POSTGRES_COMMAND_DB_USER=
POSTGRES_COMMAND_DB_PASSWORD=
POSTGRES_PROJECTION_DB_USER=
POSTGRES_PROJECTION_DB_PASSWORD=

### API Gateway — server-side JWT validation ###
# Must match the `iss` claim stamped on tokens, i.e. the URL clients use to
# request tokens from Keycloak (browser-accessible), NOT the internal Docker
# hostname — otherwise validation fails with "The iss claim is not valid".
# e.g. http://localhost:8000/realms/<your-realm>
RESOURCE_SERVER_ISSUER_URI=
# Only used to fetch signing keys, so the internal Docker hostname is fine here.
# e.g. http://keycloak:8080/realms/<your-realm>/protocol/openid-connect/certs
RESOURCE_SERVER_JWK_SET_URI=
OAUTH2_CLIENT_ID=

### API Gateway — Swagger UI OAuth2 (must be browser-accessible URLs) ###
# e.g. http://localhost:8000
KEYCLOAK_AUTH_SERVER_URL=
# e.g. e-commerce
KEYCLOAK_REALM=
# e.g. http://localhost:8080
GATEWAY_URL=
