# rename to .env and fill in the values for docker compose

### Keycloak ###
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_POSTGRES_USER=
KEYCLOAK_POSTGRES_PASSWORD=

### Services & DB ###
POSTGRES_COMMAND_DB_USER=
POSTGRES_COMMAND_DB_PASSWORD=
POSTGRES_PROJECTION_DB_USER=
POSTGRES_PROJECTION_DB_PASSWORD=

### API Gateway / Keycloak OAuth2 ###
# e.g. http://keycloak:8080/realms/<your-realm>
RESOURCE_SERVER_ISSUER_URI=
# e.g. http://keycloak:8080/realms/<your-realm>/protocol/openid-connect/certs
RESOURCE_SERVER_JWK_SET_URI=
OAUTH2_CLIENT_ID=